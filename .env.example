# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database (required in every environment) ---
DB_NAME=aakh
DB_USER=admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=55432

# --- Local development (aakh.settings.dev) ---
# Optional. Defaults to http://localhost:8000 if unset.
# WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Production / staging only (aakh.settings.production) ---
# These have NO defaults. The app refuses to start without them.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=
# ALLOWED_HOSTS=aakh.org.au,www.aakh.org.au
# WAGTAILADMIN_BASE_URL=https://aakh.org.au
